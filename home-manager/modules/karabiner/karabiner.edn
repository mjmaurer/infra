{:profiles {:Default {:default true
                      :sim     50      ;; simultaneous threshold (ms)
                      :delay   200     ;; delay until manipulation
                      :alone   200     ;; tap timeout
                      :held    250}}   ;; hold threshold

 :templates {:open  "open -a %s"}

 :applications {}

 ;; ============================================================
 ;; Layer variables (set by modifier keys held in layer mode)
 ;; ============================================================
 :layers {:semicolon-layer {:key :semicolon    :alone 200}
          :slash-layer     {:key :slash        :alone 200}
          :d-layer         {:key :d            :alone 200}
          :f-layer         {:key :f            :alone 200}
          :v-layer         {:key :v            :alone 200}}

 ;; ============================================================
 ;; Simlayers (single-key activated layers, like kanata's
 ;; tap-hold-release into layer-while-held)
 ;; ============================================================
 :simlayers {:semicolon-sim {:key :semicolon}
             :d-sim         {:key :d}
             :f-sim         {:key :f}
             :v-sim         {:key :v}}

 ;; ============================================================
 ;; Main rules
 ;; ============================================================
 :main
 [
  ;; ------------------------------------------------------------
  ;; Base remaps (always active)
  ;; ------------------------------------------------------------
  {:des "Base: caps -> esc, modifier rearrangement (mac)"
   :rules
   [;; caps lock -> escape
    [:caps_lock :escape]

    ;; Modifier rearrangement to match desired order:
    ;;   lmet  lctl  hyp    spc   ralt(arr)  rctl
    ;; Mac physical layout:  lctl lalt lmet | spc | rmet ralt
    ;; Kanata mapping:       lout=lctl  lmid=lalt  linr=lmet
    ;;                       rinr=rmet  rmid=ralt  rout=rctl
    ;; Desired in default layer:
    ;;   lctl-position -> lmet   (lout -> lmet)
    ;;   lalt-position -> lctl   (lmid -> lctl)
    ;;   lmet-position -> HYPER  (linr -> @hyp)      ← handled below
    ;;   rmet-position -> ARROW  (rinr -> @raltarr)  ← handled below
    ;;   ralt-position -> rctl   (rmid -> rctl)
    ;;   rctl-position -> rmet   (rout -> rmet)
    [:left_control  :left_command]
    [:left_option   :left_control]

    ;; Do NOT remap :right_command here using a plain goku rule.
    ;; It needs to both become right_option and set the arrow-layer variable,
    ;; which is handled by the raw Karabiner manipulator below.

    [:right_option  :right_control]
    [:right_control :right_command]]}

  ;; ------------------------------------------------------------
  ;; Hyper key — left_command physical position ($linr = lmet)
  ;; Holding it modifies other keys with lmet+lctl.
  ;; Kanata: @hyp = (multi lmet lctl)
  ;; ------------------------------------------------------------
  {:des "Hyper: left_command position -> hold = lmet+lctl modifiers"
   :rules
   [[:##left_command
     :!Tleft_command
     nil
     {:alone :left_command}]]}

  ;; ------------------------------------------------------------
  ;; Arrow layer trigger — physical right_command ($rinr = rmet)
  ;;
  ;; Kanata:
  ;;   $rinr -> @raltarr
  ;;   @raltarr = (multi ralt (layer-while-held alt-arrow))
  ;;
  ;; So physical right_command should:
  ;;   1. act as right_option while held (so other keys get option-modified)
  ;;   2. enable the arrow layer while held (so hjkl become arrows w/o option)
  ;; ------------------------------------------------------------
  {:des "Arrow trigger: physical right_command -> right_option + arrow-layer"
   :rules
   [{:type :basic
     :from {:key_code :right_command
            :modifiers {:optional [:any]}}
     :to [{:set_variable {:name "arrow-layer"
                          :value 1}}
          {:key_code :right_option
           :lazy true}]
     :to_after_key_up [{:set_variable {:name "arrow-layer"
                                        :value 0}}]}]}

  ;; ------------------------------------------------------------
  ;; Page up/down when Hyper + arrow layer active
  ;; Kanata:
  ;;   j -> down normally, page-down if hypkeys active
  ;;   k -> up normally, page-up if hypkeys active
  ;;
  ;; These must come before the plain arrow-layer j/k mappings.
  ;; ------------------------------------------------------------
  {:des "Hyper+arrow-layer j/k -> page down/up"
   :rules
   [{:type :basic
     :from {:key_code :j
            :modifiers {:mandatory [:left_command :left_control]
                        :optional [:any]}}
     :to [{:key_code :page_down}]
     :conditions [{:type :variable_if
                   :name "arrow-layer"
                   :value 1}]}

    {:type :basic
     :from {:key_code :k
            :modifiers {:mandatory [:left_command :left_control]
                        :optional [:any]}}
     :to [{:key_code :page_up}]
     :conditions [{:type :variable_if
                   :name "arrow-layer"
                   :value 1}]}]}

  ;; ------------------------------------------------------------
  ;; Arrow layer: hjkl => arrows (consume right_option so arrows
  ;; are not option-modified); tab => cmd+tab.
  ;; Trigger: physical right_command position.
  ;;
  ;; By marking right_option as MANDATORY here, Karabiner will
  ;; suppress the lazy right_option modifier when emitting the
  ;; arrow keys, giving clean arrows. Other keys not listed here
  ;; will still receive right_option as expected.
  ;; ------------------------------------------------------------
  {:des "Arrow layer (hold physical right_command / $rinr)"
   :rules
   [{:type :basic
     :from {:key_code :h
            :modifiers {:mandatory [:right_option]
                        :optional [:any]}}
     :to [{:key_code :left_arrow}]
     :conditions [{:type :variable_if
                   :name "arrow-layer"
                   :value 1}]}

    {:type :basic
     :from {:key_code :j
            :modifiers {:mandatory [:right_option]
                        :optional [:any]}}
     :to [{:key_code :down_arrow}]
     :conditions [{:type :variable_if
                   :name "arrow-layer"
                   :value 1}]}

    {:type :basic
     :from {:key_code :k
            :modifiers {:mandatory [:right_option]
                        :optional [:any]}}
     :to [{:key_code :up_arrow}]
     :conditions [{:type :variable_if
                   :name "arrow-layer"
                   :value 1}]}

    {:type :basic
     :from {:key_code :l
            :modifiers {:mandatory [:right_option]
                        :optional [:any]}}
     :to [{:key_code :right_arrow}]
     :conditions [{:type :variable_if
                   :name "arrow-layer"
                   :value 1}]}

    {:type :basic
     :from {:key_code :tab
            :modifiers {:optional [:any]}}
     :to [{:key_code :tab
           :modifiers [:left_command]}]
     :conditions [{:type :variable_if
                   :name "arrow-layer"
                   :value 1}]}]}

  ;; ------------------------------------------------------------
  ;; Tab: hold = symbol layer, double-tap = tab
  ;; Single tap produces nothing; second tap within 300ms = tab.
  ;; ------------------------------------------------------------
  {:des "Tab: hold = symbol layer, double-tap = tab"
   :rules
   [;; Double-tap: output tab when tapped while recently tapped
    {:type :basic
     :from {:key_code :tab
            :modifiers {:optional [:any]}}
     :to [{:set_variable {:name "tab-tapped" :value 0}}
          {:key_code :tab}]
     :conditions [{:type :variable_if
                   :name "tab-tapped"
                   :value 1}]}
    ;; Main: hold → activate layer, single tap → arm double-tap
    {:type :basic
     :from {:key_code :tab
            :modifiers {:optional [:any]}}
     :to [{:set_variable {:name "tab-layer-active" :value 1}}]
     :to_if_alone [{:set_variable {:name "tab-tapped" :value 1}}]
     :to_after_key_up [{:set_variable {:name "tab-layer-active" :value 0}}]
     :to_delayed_action {:to_if_invoked [{:set_variable {:name "tab-tapped" :value 0}}]
                         :to_if_canceled [{:set_variable {:name "tab-tapped" :value 0}}]}
     :parameters {:basic.to_if_alone_timeout_milliseconds 200
                  :basic.to_delayed_action_delay_milliseconds 300}}]}

  ;; ------------------------------------------------------------
  ;; Tab layer (symbols) - active while tab is held
  ;; ------------------------------------------------------------
  {:des "Tab layer: symbols"
   :rules
   [[:r [:!Ssemicolon] ["tab-layer-active" 1]]      ;; :
    [:y [:!S6] ["tab-layer-active" 1]]               ;; ^
    [:u [:!S7] ["tab-layer-active" 1]]               ;; &
    [:i [:!Sbackslash] ["tab-layer-active" 1]]       ;; |
    [:o [:!S1] ["tab-layer-active" 1]]               ;; !
    [:p [:!Sgrave_accent_and_tilde] ["tab-layer-active" 1]] ;; ~
    [:h [:!Sequal_sign] ["tab-layer-active" 1]]      ;; +
    [:j :hyphen ["tab-layer-active" 1]]
    [:k [:!Shyphen] ["tab-layer-active" 1]]          ;; _
    [:l :equal_sign ["tab-layer-active" 1]]
    [:semicolon [:!S5] ["tab-layer-active" 1]]       ;; %
    [:quote :grave_accent_and_tilde ["tab-layer-active" 1]]
    [:n [:!S8] ["tab-layer-active" 1]]               ;; *
    [:m :slash ["tab-layer-active" 1]]
    [:comma [:!Scomma] ["tab-layer-active" 1]]       ;; <
    [:period [:!Speriod] ["tab-layer-active" 1]]     ;; >
    [:slash :backslash ["tab-layer-active" 1]]]}

  ;; ------------------------------------------------------------
  ;; Semicolon layer (parens & left-side shifted nums) — hold ;
  ;; ------------------------------------------------------------
  {:des "Semicolon layer: parens & symbols"
   :rules
   [:semicolon-sim
    [:u [:!Sopen_bracket]]   ;; {
    [:i [:!Sclose_bracket]]  ;; }
    [:h :open_bracket]
    [:j [:!S9]]              ;; (
    [:k [:!S0]]              ;; )
    [:l :close_bracket]
    [:e [:!Sopen_bracket]]   ;; {
    [:r [:!Sclose_bracket]]  ;; }
    [:s :open_bracket]
    [:d [:!S9]]
    [:f [:!S0]]
    [:g :close_bracket]
    [:x [:!S2]]              ;; @
    [:c [:!S3]]              ;; #
    [:v [:!S4]]              ;; $
    [:b [:!S5]]]}            ;; %

  ;; ------------------------------------------------------------
  ;; D layer — duplicates the semicolon (parens) layer
  ;; In kanata: d is tap-hold-release into the semicolon layer.
  ;; ------------------------------------------------------------
  {:des "D layer: parens & symbols (mirror of semicolon layer)"
   :rules
   [:d-sim
    [:u [:!Sopen_bracket]]   ;; {
    [:i [:!Sclose_bracket]]  ;; }
    [:h :open_bracket]
    [:j [:!S9]]              ;; (
    [:k [:!S0]]              ;; )
    [:l :close_bracket]
    [:e [:!Sopen_bracket]]   ;; {
    [:r [:!Sclose_bracket]]  ;; }
    [:s :open_bracket]
    ;; note: :d is the trigger; skip self-mapping
    [:f [:!S0]]
    [:g :close_bracket]
    [:x [:!S2]]              ;; @
    [:c [:!S3]]              ;; #
    [:v [:!S4]]              ;; $
    [:b [:!S5]]]}            ;; %

  ;; ------------------------------------------------------------
  ;; Number layer (hold f). Top-row digits, no fork/numpad split
  ;; ------------------------------------------------------------
  {:des "Number layer: hold f for numbers under right hand"
   :rules
   [:f-sim
    [:u :7] [:i :8] [:o :9]
    [:j :4] [:k :5] [:l :6]
    [:m :1] [:comma :2] [:period :3]
    [:h :0] [:n :0]]}

  ;; ------------------------------------------------------------
  ;; Accents layer (hold v) — uses macOS Option combos
  ;; ------------------------------------------------------------
  {:des "Accents layer: hold v"
   :rules
   [:v-sim
    [:a [[:!Oe] :a]]
    [:e [[:!Oe] :e]]
    [:i [[:!Oe] :i]]
    [:o [[:!Oe] :o]]
    [:u [[:!Oe] :u]]
    [:n [[:!On] :n]]
    [:slash  [:!OSslash]]
    [:period [:!O1]]]}

  ;; ------------------------------------------------------------
  ;; Slash -> right_command when held, slash when tapped
  ;; ------------------------------------------------------------
  {:des "Slash held = right_command (mac)"
   :rules
   [;; Override: slash-hold + space → "/ " (fast-typing overlap fix)
    ;; mandatory right_command is consumed by the match, so the
    ;; output slash and space are emitted without the modifier.
    {:type :basic
     :from {:key_code :spacebar
            :modifiers {:mandatory [:right_command]
                        :optional [:any]}}
     :to [{:key_code :slash}
          {:key_code :spacebar}]
     :conditions [{:type :variable_if
                   :name "slash-held"
                   :value 1}]}
    ;; Main rule: slash held = right_command (immediate activation)
    {:type :basic
     :from {:key_code :slash
            :modifiers {:optional [:any]}}
     :to [{:set_variable {:name "slash-held" :value 1}}
          {:key_code :right_command}]
     :to_if_alone [{:key_code :slash}]
     :to_after_key_up [{:set_variable {:name "slash-held" :value 0}}]
     :parameters {:basic.to_if_alone_timeout_milliseconds 200}}]}
 ]}
